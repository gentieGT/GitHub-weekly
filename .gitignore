inbox/ideas.jsonl
inbox/reports.jsonl

# 企业微信 webhook（含密钥）
config/wecom.json

# Star 状态缓存（含你的 GitHub 行为记录）
data/star-cache.json

# ══════════════════════════════════════════════════════════════
# 以下必须提交，不要加进忽略列表
# ══════════════════════════════════════════════════════════════
# - data/weekly-*.json     历史榜单，是项目的数据资产
